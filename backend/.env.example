PORT=4000
# Prefer DATABASE_URL on Railway (use Private Network vars / reference from Postgres plugin).
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Or discrete settings (needed if DATABASE_URL unset):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mission_planner
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
JWT_SECRET=change_this_for_production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=*
