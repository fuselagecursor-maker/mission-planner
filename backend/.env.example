PORT=4000
# Prefer DATABASE_URL on Railway (use Private Network vars / reference from Postgres plugin).
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Railway also sets PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD — the backend uses
# those if DATABASE_URL / POSTGRES_URL / DATABASE_PRIVATE_URL are empty.

# Or discrete settings (local dev if no URL):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mission_planner
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
JWT_SECRET=change_this_for_production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=*
